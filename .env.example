PUSHER_APP_ID=replace-with-pusher-app-id
PUSHER_KEY=replace-with-pusher-key
PUSHER_SECRET=replace-with-rotated-pusher-secret
PUSHER_CLUSTER=ap1

# Realtime server. Leave PUSHER_HOST empty to use Pusher's cloud with the keys
# above. Set it to use the self-hosted Sockudo container instead; the keys above
# then become Sockudo's own app id/key/secret (pick fresh random values).
#   Local dev:   PUSHER_HOST=sockudo  PUSHER_PORT=6001  PUSHER_SCHEME=http  PUSHER_WS_PORT=6001
#   Production:  same, but PUSHER_WS_PORT empty: browsers use the site's own
#                host and port, and the reverse proxy sends /app/ to port 6001.
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=
PUSHER_WS_HOST=
PUSHER_WS_PORT=

# Copy this file to .env for local development. Never commit the real .env.
BOOKING_MICROSOFT_ONLY=1
BOOKING_MICROSOFT_CLIENT_ID=
BOOKING_MICROSOFT_CLIENT_SECRET=
BOOKING_MICROSOFT_TENANT=
BOOKING_MICROSOFT_ALLOWED_DOMAINS=cmu.ac.th
BOOKING_MICROSOFT_REDIRECT_URI=http://localhost:8080/microsoft/callback.php